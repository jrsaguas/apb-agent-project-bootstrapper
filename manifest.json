{
  "manifest_version": 3,
  "name": "APB — Agent Project Bootstrapper",
  "version": "0.1.0",
  "description": "Orquesta proyectos ChatGPT, repositorios y ciclos de trabajo continuo supervisado.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "APB"},
  "side_panel": {"default_path": "sidepanel.html"},
  "content_scripts": [{"matches":["https://chatgpt.com/*","https://chat.openai.com/*"],"js":["content.js"],"run_at":"document_idle"}]
}